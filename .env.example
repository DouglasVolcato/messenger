# Application
PORT=8080
DB_URL=postgres://messager:messager@localhost:5432/messager?sslmode=disable
MIGRATIONS_DIR=migrations
JWT_SECRET=change-me
PASSWORD_SALT=change-me

# PostgreSQL
POSTGRES_DB=messager
POSTGRES_USER=messager
POSTGRES_PASSWORD=messager
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=messager
RABBITMQ_DEFAULT_PASS=messager
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

# Nginx
NGINX_PORT=80

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Application
PORT=8080
DB_URL=postgres://messager:messager@localhost:5432/messager?sslmode=disable
MIGRATIONS_DIR=migrations
JWT_SECRET=change-me
PASSWORD_SALT=change-me

# PostgreSQL
POSTGRES_DB=messager
POSTGRES_USER=messager
POSTGRES_PASSWORD=messager

# RabbitMQ
RABBITMQ_DEFAULT_USER=messager
RABBITMQ_DEFAULT_PASS=messager

# Nginx entrypoint
NGINX_PORT=80

# Optional comma-separated list of browser origins allowed to open the
# WebSocket when the application and WebSocket use different hostnames.
# Same-host origins are accepted automatically.
WEBSOCKET_ALLOWED_ORIGINS=

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# PostgreSQL, Redis, RabbitMQ, Prometheus and Grafana use fixed internal
# container ports and are not published on the Docker host.
